{
  "name": "marigold-player",
  "productName": "Marigold Player",
  "version": "0.3.1",
  "description": "A calm, orange-accented desktop media player that plays almost any video or music format. Built with Electron.",
  "main": "main.js",
  "author": "furyengi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:ci": "node scripts/ci-build.js never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.7.1": true,
    "ffmpeg-static@5.3.0": true
  },
  "build": {
    "appId": "com.furyengi.marigold",
    "productName": "Marigold Player",
    "copyright": "Copyright © furyengi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "furyengi",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "files": [
      "main.js",
      "engine.js",
      "updater.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mkv",
          "webm",
          "mov",
          "avi",
          "ogv",
          "mpg",
          "mpeg",
          "mp3",
          "flac",
          "wav",
          "ogg",
          "oga",
          "opus",
          "m4a",
          "aac"
        ],
        "name": "Media file",
        "role": "Viewer"
      }
    ],
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "furyengi",
        "repo": "marigold-player",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furyengi/marigold-player.git"
  },
  "homepage": "https://github.com/furyengi/marigold-player#readme",
  "engines": {
    "node": ">=20"
  }
}
